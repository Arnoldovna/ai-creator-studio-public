# Copy to apps/web/.env.local (Next.js app) — never commit real secrets.

# ---------- AI providers (server-side only, never sent to the browser) ----------
# mock | openrouter | anthropic | openai. Paid providers only activate with an API key AND a budget > 0.
# openrouter = Model Router: picks the model per task (registry: packages/core/src/router/registry.ts).
AI_PROVIDER=mock
# Hard monthly limit in USD (suggested development budget: 15). 0 = no paid calls at all.
AI_MONTHLY_BUDGET_USD=0
# Warn from this fraction of the budget (default 0.8)
# AI_BUDGET_WARN_FRACTION=0.8
# Max USD for one Evaluation-Lab comparison run (default 0.5)
# EVAL_MAX_USD_PER_RUN=0.5
# OPENROUTER_API_KEY=
# Model families allowed to receive confidential UGC client data (strict zero-data-retention endpoints only).
# Empty = client projects are never sent to a paid model. Example: anthropic,openai
# CONFIDENTIAL_ALLOWED_FAMILIES=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional price override in USD per million tokens (defaults built in for Claude models)
# ANTHROPIC_INPUT_USD_PER_MTOK=
# ANTHROPIC_OUTPUT_USD_PER_MTOK=
# OPENAI_API_KEY=
# OPENAI_MODEL=            # a vision-capable model you have access to
# OPENAI_INPUT_USD_PER_MTOK=
# OPENAI_OUTPUT_USD_PER_MTOK=

# ---------- Access control ----------
# Unset: UI/API only answer requests addressed to localhost/127.0.0.1.
# STUDIO_ACCESS_TOKEN=change-me-long-random
# Bearer token n8n uses for /api/jobs/* (endpoints are disabled while unset).
# STUDIO_JOB_TOKEN=change-me-long-random

# ---------- Storage / media ----------
# Default: apps/web/.data (db.json + media/ + keyframes/)
# STUDIO_DATA_DIR=
# Standard folder (Etappe 10): the active strategy, profile, Style Bible and Voice Guide are written here as JSON
# on every activation (strategie.json, profil.json incl. the local part, style-bible.json, voice.json, manifest.json;
# folder 0700, files 0600). An empty data folder is seeded from it; existing data is never overwritten.
# Default: ~/Documents/AI Creator Studio (privat)/standard/ · `off` switches it off (tests always set off).
# STUDIO_DEFAULTS_DIR=
# FFmpeg/ffprobe from the system (ADR-009): `brew install ffmpeg`. Found in /opt/homebrew/bin,
# /usr/local/bin or /usr/bin; set the paths only for another install.
# FFmpeg mit libass (Untertitel, Hook, Overlays, KI-Label). Wenn Homebrews ffmpeg-full nicht baut (Intel-Mac):
# eigener Build mit --enable-libass, z. B. nach ~/.local/opt/ffmpeg-libass, und hier eintragen.
# FFMPEG_PATH=
# FFPROBE_PATH=
# Video worker: jobs at the same time (1–2)
# VIDEO_WORKER_CONCURRENCY=1
# Footage limits in bytes (defaults 4 GB per file, 50 GB per project)
# FOOTAGE_MAX_BYTES=
# FOOTAGE_MAX_PROJECT_BYTES=
# Transcription (ADR-009): whisper.cpp locally (`brew install whisper-cpp`), models in ~/.cache/whisper.cpp.
# TRANSCRIPTION=mock gives labelled stand-ins without whisper.cpp.
# TRANSCRIPTION=
# WHISPER_CLI=
# WHISPER_MODEL=
# WHISPER_VAD_MODEL=
# WHISPER_THREADS=8
# Etappe 8: fixed initial prompt with fillers and normal casing/punctuation (0 = off), so „ähm“ is transcribed.
# WHISPER_FILLER_PROMPT=1
# Etappe 8: DTW word times (-dtw, runs with -nfa, about 1.4x slower) so fillers can be placed in the audio (0 = off).
# WHISPER_DTW=1

# ---------- Generated B-roll (Release 3, Etappe 7, ADR-010) ----------
# Off by default. cli = the Higgsfield CLI (set it up yourself: `higgsfield auth login`, then pick the billing workspace with `higgsfield workspace list` / `higgsfield workspace set <id>`), mock = labelled test pattern, no credits.
# HIGGSFIELD=off
# HIGGSFIELD_CLI=
# Monthly credit budget across all projects (0 = no paid job can be approved); per-project budgets are set in the Video Studio.
# HIGGSFIELD_MONTHLY_CREDITS=0

# ---------- Not used yet (Supabase adapter not implemented) ----------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------- n8n (docker-compose.yml, repo root .env) ----------
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_ENCRYPTION_KEY=replace-with-a-strong-random-32-plus-character-string
